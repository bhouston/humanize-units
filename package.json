{
  "name": "humanize-units",
  "version": "2.0.4",
  "description": "Efficient TypeScript utilities for converting numeric values to human friendly rounded strings with unit / magnitude prefixes.",
  "keywords": [
    "bytes",
    "count",
    "esm",
    "format",
    "humanize",
    "seconds",
    "typescript",
    "unit"
  ],
  "license": "MIT",
  "author": "Ben Houston <ben@ben3d.ca> (https://ben3d.ca)",
  "repository": {
    "type": "git",
    "url": "https://github.com/bhouston/humanize-units.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsgo",
    "tsc": "tsgo",
    "clean": "rimraf dist",
    "clean:all": "pnpm clean &&rimraf node_modules",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "make-release": "node scripts/make-release.ts ."
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
    "@vitest/coverage-v8": "^4.1.5",
    "husky": "^9.1.7",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "rimraf": "^6.0.1",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.0.8"
}
